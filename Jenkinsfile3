pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        DOCKER_IMAGE = "olabode111/testapp"
        ANSIBLE_HOST = "51.44.209.72"
        NEXUS_URL = "13.38.80.100:8081"
        APP_URL = "https://www.everythingops.io/"
    }

    stages {
        stage('Code Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage("Quality Gate") {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency Check') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                    dependencyCheck additionalArguments: "--scan ./ --disableYarnAudit --disableNodeAudit --nvdApiKey ${env.NVD_API_KEY}", odcInstallation: 'DP-Check'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Build Artifact') {
            steps {
                sh 'mvn -f pom.xml clean package -DskipTests -Dcheckstyle.skip'
            }
        }

        stage('Push Artifact to Nexus Repo') {
            steps {
                nexusArtifactUploader artifacts: [[
                    artifactId: 'spring-petclinic',
                    classifier: '',
                    file: 'target/spring-petclinic-2.4.2.war',
                    type: 'war'
                ]],
                credentialsId: 'nexus-creds',
                groupId: 'Petclinic',
                nexusUrl: "${NEXUS_URL}",
                nexusVersion: 'nexus3',
                protocol: 'http',
                repository: 'nexus-repo',
                version: '1.0'
            }
        }

        stage('Build Docker Image with Ansible') {
            steps {
                sshagent(['ansible-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ec2-user@${ANSIBLE_HOST} \
                        "ansible-galaxy collection install community.docker && cd /etc/ansible && ansible-playbook /opt/docker/docker-image.yml"
                    """
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                    --scanners vuln,secret \
                    --timeout 15m \
                    ${DOCKER_IMAGE}:latest > trivyimage.txt
                """
            }
        }

        stage('Archive Trivy Report') {
            steps {
                archiveArtifacts artifacts: 'trivyimage.txt', fingerprint: true
            }
        }

        stage('Deploy to Stage') {
            steps {
                sshagent(['ansible-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ec2-user@${ANSIBLE_HOST} \
                        "cd /etc/ansible && ansible-playbook /opt/docker/docker-container.yml"

                        ssh -o StrictHostKeyChecking=no ec2-user@${ANSIBLE_HOST} \
                        "cd /etc/ansible && ansible-playbook /opt/docker/newrelic-container.yml"
                    """
                }
            }
        }

        stage('Check Website Availability') {
            steps {
                sh "sleep 90"
                script {
                    def response = sh(script: "curl -s -o /dev/null -w \"%{http_code}\" ${APP_URL}", returnStdout: true).trim()

                    if (response == "200") {
                        slackSend(color: 'good', message: "The stage PetClinic Java application is up and running with HTTP status code ${response}.", tokenCredentialId: 'slack-cred')
                    } else {
                        slackSend(color: 'danger', message: "The stage PetClinic Java application appears to be down with HTTP status code ${response}.", tokenCredentialId: 'slack-cred')
                        error("Website health check failed with status code ${response}")
                    }
                }
            }
        }

        stage('Request for Approval') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Needs Approval', submitter: 'admin'
                }
            }
        }

        stage('Deploy to Prod') {
            steps {
                sshagent(['ansible-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ec2-user@${ANSIBLE_HOST} \
                        "cd /etc/ansible && ansible-playbook /opt/docker/docker-container.yml"

                        ssh -o StrictHostKeyChecking=no ec2-user@${ANSIBLE_HOST} \
                        "cd /etc/ansible && ansible-playbook /opt/docker/newrelic-container.yml"
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
